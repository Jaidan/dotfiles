# Portable git settings, linked to ~/.gitconfig.shared and pulled in by an
# [include] at the top of each machine's real ~/.gitconfig (see
# install/setup-gitconfig.sh). Machine-specific entries (credential helpers,
# editor overrides) belong in ~/.gitconfig, never here.
[user]
	name = John Williams
	email = john@rover.com
[core]
	excludesfile = ~/.gitignore
	editor = nvim
	templatedir = ~/.git_template
[alias]
	co = checkout
[color]
	branch = auto
	diff = auto
	status = auto
	interactive = auto
[push]
	default = simple
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[difftool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[merge]
	tool = nvimdiff
