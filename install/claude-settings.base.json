{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 1,
    "refreshInterval": 10
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "editorMode": "vim",
  "theme": "dark",
  "tui": "fullscreen",
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "preferredNotifChannel": "terminal_bell"
}
